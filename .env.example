# --- required ---------------------------------------------------------------
# SEC requires a User-Agent identifying you (name + contact email).
EDGAR_USER_AGENT="Your Name yourname@example.com"

# Anthropic API key for the LLM analyst.
ANTHROPIC_API_KEY=sk-ant-...

# --- trading ----------------------------------------------------------------
# dry_run -> log hypothetical trades | recommend -> reports + notifications | auto -> place orders
TRADE_MODE=dry_run
KILL_SWITCH=false

# Robinhood Trading MCP (required for quotes/portfolio/orders; leave the token
# empty to run data-only). The URL defaults to Robinhood's official endpoint
# (https://agent.robinhood.com/mcp/trading) — only override it if you're using a
# community/self-hosted MCP wrapper.
ROBINHOOD_MCP_TOKEN=
ROBINHOOD_ACCOUNT_NUMBER=
#ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading

# --- hard risk limits (code-enforced; the LLM cannot override) ---------------
MAX_POSITION_USD=1000
MAX_DAILY_DEPLOYMENT_USD=3000
MAX_OPEN_POSITIONS=20
MIN_CASH_RESERVE_USD=500
MAX_POSITION_PCT_OF_PORTFOLIO=0.10
MIN_CONVICTION_TO_TRADE=4
# Skip orders smaller than this (fractional shares supported).
MIN_ORDER_USD=10
# Simulated cash used by dry_run/recommend when no broker is connected.
PAPER_CASH_USD=10000

# --- optional ----------------------------------------------------------------
# Webhook that receives {"text": "..."} for buy/sell recommendations (Slack-compatible).
NOTIFY_WEBHOOK_URL=
NEWS_POLL_SECONDS=90
CANDIDATE_POOL_SIZE=200
DB_PATH=data/bot.db
ANTHROPIC_MODEL=claude-opus-4-8
